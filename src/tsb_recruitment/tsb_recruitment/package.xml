<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tsb_recruitment</name>
  <version>0.1.0</version>
  <description>
    Metapackage to bundle TSB Recruitment Project packages.
  </description>
  <maintainer email="tecnico.solarboat@gmail.com">Técnico Solar Boat</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dependencies on bundled packages -->
  <exec_depend>tsb_recruitment_bringup</exec_depend>
  <exec_depend>tsb_recruitment_interfaces</exec_depend>
  <exec_depend>tsb_recruitment_sim</exec_depend>
  <exec_depend>tsb_recruitment_datagenerator</exec_depend>
  <exec_depend>otter_description</exec_depend>
  <exec_depend>sp01_description</exec_depend>


  <export>
    <type>metapackage</type>
    <build_type>ament_cmake</build_type>
  </export>
</package>
